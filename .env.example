# =================================================================
#               CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# =================================================================

# Porta em que o servidor da aplicação irá rodar.
# Padrão: 8000
PORT=8000


# =================================================================
#               CHAVES DA API DA OPENROUTER (OBRIGATÓRIO)
# =================================================================
# Adicione aqui suas chaves de API da OpenRouter para que o serviço
# de inteligência artificial funcione.
#
# O sistema implementa rotação de chaves: ele alternará entre todas as
# chaves fornecidas para distribuir as requisições e evitar limites de taxa.
# Você pode adicionar quantas chaves quiser, seguindo o padrão numérico.
#
# Exemplo:
# OPENROUTER_API_KEY_1="sk-or-v1-abc...xyz"
# OPENROUTER_API_KEY_2="sk-or-v1-def...uvw"

OPENROUTER_API_KEY_1=""
OPENROUTER_API_KEY_2=""
OPENROUTER_API_KEY_3=""
OPENROUTER_API_KEY_4=""
OPENROUTER_API_KEY_5=""


# =================================================================
#               BANCO DE DADOS (Substituído por Excel)
# =================================================================
# A variável DATABASE_URL não é mais necessária, pois a aplicação
# foi adaptada para usar arquivos Excel como banco de dados.
# Os arquivos .xlsx serão criados e gerenciados automaticamente
# na pasta 'database' na raiz do projeto.
# DATABASE_URL=


# =================================================================
#               CONFIGURAÇÕES REMOVIDAS
# =================================================================
# As seguintes variáveis não são mais necessárias:
# - GOOGLE_API_KEY_*
# - GOOGLE_CLIENT_ID
# - GOOGLE_CLIENT_SECRET